meta {
  name: Toggle Task Completion
  type: http
  seq: 7
}

patch {
  url: http://localhost:3000/api/tasks/:id/toggle-complete
  body: none
  auth: none
}

docs {
  Toggles the completion status of a task (completed ↔ not completed).
  
  Path parameters:
  - id: The MongoDB ObjectId of the task to toggle
  
  This endpoint requires no request body. It simply flips the current
  completion status of the task to its opposite.
  
  Returns the updated task with the new completion status.
  Returns a 404 error if the task with the specified ID is not found.
} 