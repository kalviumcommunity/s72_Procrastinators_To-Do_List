meta {
  name: Get All Tasks
  type: http
  seq: 2
}

get {
  url: http://localhost:3000/api/tasks
  body: none
  auth: none
}

query {
  completed: 
  priority: 
  inGraveyard: 
}

docs {
  Retrieves all tasks from the system.
  
  Query parameters (all optional):
  - completed: filter by completion status (true/false)
  - priority: filter by priority level ("Low", "Medium", "High")
  - inGraveyard: filter by graveyard status (true/false)
  
  All tasks are returned sorted by creation date (newest first).
} 