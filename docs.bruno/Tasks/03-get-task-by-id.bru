meta {
  name: Get Task by ID
  type: http
  seq: 3
}

get {
  url: http://localhost:3000/api/tasks/:id
  body: none
  auth: none
}

headers {
  Content-Type: application/json
}

docs {
  Retrieves a specific task by its MongoDB ObjectId.
  
  Path parameters:
  - id: The MongoDB ObjectId of the task to retrieve
  
  Returns a 404 error if the task with the specified ID is not found.
} 