meta {
  name: Delete Task
  type: http
  seq: 5
}

delete {
  url: http://localhost:3000/api/tasks/:id
  body: none
  auth: none
}

docs {
  Deletes a task from the system.
  
  Path parameters:
  - id: The MongoDB ObjectId of the task to delete
  
  Returns a success message if deleted successfully.
  Returns a 404 error if the task with the specified ID is not found.
} 